     def reroute(self, context, path=None, params=None, uri=None):
         ui = context.get_ui()
+
+        # Therand inline previews own Home only.  While such a preview session
+        # exists, leaving Home (Settings, another window, etc.) must never let
+        # YouTube's generic window-cache reroute machinery activate Videos/
+        # MyVideoNav and replace the user's destination with e.g.
+        # /special/my_subscriptions.
+        #
+        # This is intentionally scoped to the Home property published by
+        # service.therand.autotrailer; ordinary YouTube navigation is untouched.
+        try:
+            therand_preview_session = (
+                xbmcgui.Window(10000)
+                .getProperty('TherandInset.Session')
+                .strip()
+                .lower()
+            )
+        except Exception:
+            therand_preview_session = ''
+
+        if (
+            therand_preview_session in ('1', 'true', 'yes')
+            and not xbmc.getCondVisibility('Window.IsActive(Home)')
+        ):
+            self.log.debug(
+                'Therand preview session outside Home - suppressing YouTube reroute'
+            )
+            return False, {self.FALLBACK: False}
